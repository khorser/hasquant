---

"a:" means an abstract class, i.e. interface only

a:Instrument
    a:Forward : Instrument | qlForwardAsInstrument
	ForwardRateAgreement : Forward | qlForwardRateAgreementAsForward
	FixedRateBondForward : Forward | qlFixedRateBondForwardAsForward
    a:Option : Instrument | qlOptionAsInstrument
	CdsOption : Option | qlCdsOptionAsOption
	MultiAssetOption : Option | qlMultiAssetOptionAsOption
	    MargrabeOption : MultiAssetOption | qlMargrabeOptionAsMultiAssetOption
	OneAssetOption : Option | qlOneAssetOptionAsOption
	    BarrierOption : OneAssetOption | qlBarrierOptionAsOneAssetOption
	    DividendVanillaOption : OneAssetOption | qlDividendVanillaOptionAsOneAssetOption
	    ForwardVanillaOption : OneAssetOption | qlForwardVanillaOptionAsOneAssetOption
	    QuantoVanillaOption : OneAssetOption | qlQuantoVanillaOptionAsOneAssetOption
	    VanillaOption : OneAssetOption | qlVanillaOptionAsOneAssetOption
	QuantoBarrierOption : Option | qlQuantoBarrierOptionAsBarrierOption >=> asOneAssetOption >=> asOption
	QuantoForwardVanillaOption : Option | qlQuantoForwardVanillaOptionAsForwardVanillaOption >=> asOneAssetOption >=> asOption
	Swaption : Option | qlSwaptionAsOption
    a:Swap : Instrument | qlSwapAsInstrument
	VanillaSwap : Swap | qlVanillaSwapAsSwap
	AssetSwap : Swap | qlAssetSwapAsSwap
	BMASwap : Swap | qlBMASwapAsSwap
	OvernightIndexedSwap : Swap | qlOvernightIndexedSwapAsSwap
    CreditDefaultSwap : Instrument | qlCreditDefaultSwapAsInstrument
    CapFloor : Instrument | qlCapFloorAsInstrument
    Bond : Instrument | qlBondAsInstrument
	ConvertibleBond : Bond | qlConvertibleBondAsBond
    	FixedRateBond : Bond | qlFixedRateBondAsBond
	CallableBond : Bond | qlCallableBondAsBond

a:Index
    a:InterestRateIndex : Index | qlInterestRateIndexAsIndex
	BMAIndex : InterestRateIndex | qlBMAIndexAsInterestRateIndex
    	SwapIndex : InterestRateIndex | qlSwapIndexAsInterestRateIndex
	    OvernightIndexedSwapIndex : SwapIndex | qlOvernightIndexedSwapIndexAsSwapIndex
	IborIndex : InterestRateIndex | qlIborIndexAsInterestRateIndex
	    OvernightIborIndex : IborIndex | qlOvernightIndexAsIborIndex

a:TermStructure
    YieldTermStructure : TermStructure | qlYieldTermStructureAsTermStructure
	FittedBondDiscountCurve : YieldTermStructure | qlFittedBondDiscountCurveAsYieldTermStructure
    VolatilityTermStructure : TermStructure | qlVolatilityTermStructureAsTermStructure
	OptionletVolatilityStructure : VolatilityTermStructure | qlOptionletVolatilityStructureAsVolatilityTermStructure
	BlackVolTermStructure : VolatilityTermStructure | qlBlackVolTermStructureAsVolatilityTermStructure
	    BlackVarianceCurve : BlackVolTermStructure | qlBlackVarianceCurveAsBlackVolTermStructure
	SwaptionVolatilityStructure : VolatilityTermStructure | qlSwaptionVolatilityStructureAsVolatilityTermStructure
	CapFloorTermVolSurface : VolatilityTermStructure | qlCapFloorTermVolSurfaceAsVolatilityTermStructure
	LocalVolTermStructure : VolatilityTermStructure | qlLocalVolTermStructureAsVolatilityTermStructure
    CallableBondVolatilityStructure : TermStructure | qlCallableBondVolatilityStructureAsTermStructure;
    DefaultProbabilityTermStructure : TermStructure | qlDefaultProbabilityTermStructureAsTermStructure

