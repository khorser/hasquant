a:AffineModel
    (AffineModelDescendant OneFactorAffineModel) : AffineModel | cast (AffineModelDescendant x) = qlOneFactorAffineModelAsAffineModel x
    (AffineModelDescendant LiborForwardModel) : AffineModel | cast (AffineModelDescendant x) = qlLiborForwardModelAsAffineModel x
    (AffineModelDescendant G2) : AffineModel | cast (AffineModelDescendant x) = qlG2AsAffineModel x
