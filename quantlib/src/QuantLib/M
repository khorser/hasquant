CFLAGS=-Wall -Wextra -pedantic

cobj:
	mkdir cobj

libql.dll: $(OBJS)
	g++ --shared -o libql.dll $(OBJS) -static-libstdc++ -static-libgcc -Wl,--output-def,cobj/libql.def,--out-implib,cobj/libql.a -lQuantLib $(EXTRA)

libql.so: $(OBJS)
	g++ --shared -o libql.so $(OBJS) -lQuantLib $(EXTRA)

cobj/qlBond.o: $(QLCSRC)/qlaux.h $(QLCSRC)/qlBond.h $(QLCSRC)/qlBond.cpp | cobj
