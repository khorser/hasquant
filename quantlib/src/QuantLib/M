QLC_SRC=../../../qlc/cbits

SRC=$(wildcard $(QLC_SRC)/ql*.cpp)

OBJ=$(subst $(QLC_SRC),cobj,$(SRC:.cpp=.o))

CFLAGS=-Wall -Wextra -pedantic

cobj:
	mkdir cobj

libql.dll: $(OBJ)
	g++ --shared -o libql.dll $(OBJ) -static-libstdc++ -static-libgcc -Wl,--output-def,cobj/libql.def,--out-implib,cobj/libql.a -lQuantLib $(EXTRA)

libql.so: $(OBJ)
	g++ --shared -o libql.so $(OBJ) -lQuantLib $(EXTRA)

cobj/qlPricingEngineAux.o: $(QLC_SRC)/qlPricingEngineAux.cpp $(QLC_SRC)/qlPricingEngineAux.h | cobj
	g++ -c $(CFLAGS) $(EXTRA) -o cobj/qlPricingEngineAux.o $(QLC_SRC)/qlPricingEngineAux.cpp

cobj/qlTSAux.o: $(QLC_SRC)/qlTSAux.cpp $(QLC_SRC)/qlTSAux.h | cobj
	g++ -c $(CFLAGS) $(EXTRA) -o cobj/qlTSAux.o $(QLC_SRC)/qlTSAux.cpp

cobj/qlPricingEngine.o: $(QLC_SRC)/qlPricingEngine.cpp $(QLC_SRC)/qlaux.h $(QLC_SRC)/qlPricingEngine.h $(QLC_SRC)/qlPricingEngineAux.h | cobj

cobj/qlDefaultTS.o: $(QLC_SRC)/qlDefaultTS.cpp $(QLC_SRC)/qlaux.h $(QLC_SRC)/qlDefaultTS.h $(QLC_SRC)/qlTSAux.h | cobj

cobj/qlVolatilityTS.o: $(QLC_SRC)/qlVolatilityTS.cpp $(QLC_SRC)/qlaux.h $(QLC_SRC)/qlVolatilityTS.h $(QLC_SRC)/qlTSAux.h | cobj

cobj/qlYieldTS.o: $(QLC_SRC)/qlYieldTS.cpp $(QLC_SRC)/qlaux.h $(QLC_SRC)/qlYieldTS.h $(QLC_SRC)/qlTSAux.h | cobj

cobj/%.o: $(QLC_SRC)/%.cpp $(QLC_SRC)/qlaux.h $(QLC_SRC)/%.h | cobj
	g++ -c -DDLLSOURCE $(CFLAGS) $(EXTRA) -o $@ $<

