QLCSRC=../../../qlc/cbits

SRC=$(wildcard ../../../qlc/cbits/ql*.cpp)

OBJ=$(subst ../../../qlc/cbits,cobj,$(SRC:.cpp=.o))

CFLAGS=-Wall -Wextra -pedantic

cobj:
	mkdir cobj

libql.dll: $(OBJ)
	g++ --shared -o libql.dll $(OBJ) -static-libstdc++ -static-libgcc -Wl,--output-def,cobj/libql.def,--out-implib,cobj/libql.a -lQuantLib $(EXTRA)

libql.so: $(OBJ)
	g++ --shared -o libql.so $(OBJ) -lQuantLib $(EXTRA)

cobj/qlPricingEngineAux.o: $(QLCSRC)/qlPricingEngineAux.cpp $(QLCSRC)/qlPricingEngineAux.h | cobj
	g++ -c $(CFLAGS) $(EXTRA) -o cobj/qlPricingEngineAux.o $(QLCSRC)/qlPricingEngineAux.cpp

cobj/qlTSAux.o: $(QLCSRC)/qlTSAux.cpp $(QLCSRC)/qlTSAux.h | cobj
	g++ -c $(CFLAGS) $(EXTRA) -o cobj/qlTSAux.o $(QLCSRC)/qlTSAux.cpp

cobj/qlPricingEngine.o: $(QLCSRC)/qlPricingEngine.cpp $(QLCSRC)/qlaux.h $(QLCSRC)/qlPricingEngine.h $(QLCSRC)/qlPricingEngineAux.h | cobj

cobj/qlDefaultTS.o: $(QLCSRC)/qlDefaultTS.cpp $(QLCSRC)/qlaux.h $(QLCSRC)/qlDefaultTS.h $(QLCSRC)/qlTSAux.h | cobj

cobj/qlVolatilityTS.o: $(QLCSRC)/qlVolatilityTS.cpp $(QLCSRC)/qlaux.h $(QLCSRC)/qlVolatilityTS.h $(QLCSRC)/qlTSAux.h | cobj

cobj/qlYieldTS.o: $(QLCSRC)/qlYieldTS.cpp $(QLCSRC)/qlaux.h $(QLCSRC)/qlYieldTS.h $(QLCSRC)/qlTSAux.h | cobj

cobj/%.o: $(QLCSRC)/%.cpp $(QLCSRC)/qlaux.h $(QLCSRC)/%.h | cobj
	g++ -c -DDLLSOURCE $(CFLAGS) $(EXTRA) -o $@ $<

