    <briefdescription>
<para>Hungarian calendar. </para>    </briefdescription>
    <detaileddescription>
<para>Holidays: <itemizedlist>
<listitem>
<para>Saturdays </para></listitem>
<listitem>
<para>Sundays </para></listitem>
<listitem>
<para>Easter Monday </para></listitem>
<listitem>
<para>Whit(Pentecost) Monday  </para></listitem>
<listitem>
<para>New Year&apos;s Day, January 1st </para></listitem>
<listitem>
<para>National Day, March 15th </para></listitem>
<listitem>
<para>Labour Day, May 1st </para></listitem>
<listitem>
<para>Constitution Day, August 20th </para></listitem>
<listitem>
<para>Republic Day, October 23rd </para></listitem>
<listitem>
<para>All Saints Day, November 1st </para></listitem>
<listitem>
<para>Christmas, December 25th </para></listitem>
<listitem>
<para>2nd Day of Christmas, December 26th </para></listitem>
</itemizedlist>
</para>    </detaileddescription>
