        <type><ref refid="group__types_1gaaa95ab7fe66935e3f7535413fad2a7d3" kindref="member">Volatility</ref></type>
        <definition>virtual Volatility totalVariance</definition>
        <argsstring>(const Date &amp;exerciseDate, Rate strike, const Period &amp;obsLag=Period(-1, Days), bool extrapolate=false) const </argsstring>
        <name>totalVariance</name>
        <param>
          <type>const Date &amp;</type>
          <declname>exerciseDate</declname>
        </param>
        <param>
          <type><ref refid="group__types_1gaede435af51236692b1107d7639581d39" kindref="member">Rate</ref></type>
