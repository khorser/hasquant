    <briefdescription>
<para>Australian calendar. </para>    </briefdescription>
    <detaileddescription>
<para>Holidays: <itemizedlist>
<listitem>
<para>Saturdays </para></listitem>
<listitem>
<para>Sundays </para></listitem>
