    <briefdescription>
<para>Swedish calendar. </para>    </briefdescription>
    <detaileddescription>
<para>Holidays: <itemizedlist>
<listitem>
<para>Saturdays </para></listitem>
<listitem>
<para>Sundays </para></listitem>
<listitem>
<para>New Year&apos;s Day, January 1st </para></listitem>
<listitem>
<para>Epiphany, January 6th </para></listitem>
<listitem>
<para>Good Friday </para></listitem>
<listitem>
<para>Easter Monday </para></listitem>
<listitem>
<para>Ascension </para></listitem>
<listitem>
<para>Whit(Pentecost) Monday  </para></listitem>
<listitem>
<para>May Day, May 1st </para></listitem>
<listitem>
<para>National Day, June 6th </para></listitem>
<listitem>
<para>Midsummer Eve (Friday between June 19-25) </para></listitem>
<listitem>
<para>Christmas Eve, December 24th </para></listitem>
<listitem>
<para>Christmas Day, December 25th </para></listitem>
<listitem>
<para>Boxing Day, December 26th </para></listitem>
<listitem>
<para>New Year&apos;s Eve, December 31th </para></listitem>
</itemizedlist>
</para>    </detaileddescription>
