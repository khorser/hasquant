  <compounddef id="date_generation" kind="struct" prot="public">
    <compoundname>DateGeneration</compoundname>
    <includes local="no">/time/dategenerationrule.hpp</includes>
      <sectiondef kind="public-type">
      <memberdef kind="enum" id="date_generation_1a11fcd51ef86118f65e603c1474377a78" prot="public" static="no">
        <name>Rule</name>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78a67e19347f85332c3bbfd61266cecbe4e" prot="public">
          <name>Backward</name>
          <detaileddescription>
<para>Backward from termination date to effective date. </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78ae204c9c3e62b1e9a6b60e40cd05256c5" prot="public">
          <name>Forward</name>
          <detaileddescription>
<para>Forward from effective date to termination date. </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78ab9f6920de535f04ccfe34d670fa2c8a8" prot="public">
          <name>Zero</name>
          <detaileddescription>
<para>No intermediate dates between effective date and termination date. </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78ac8d8da6652fd8ffa5e27e779518e414e" prot="public">
          <name>ThirdWednesday</name>
          <detaileddescription>
<para>All dates but effective date and termination date are taken to be on the third wednesday of their month (with forward calculation.) </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78a21087b4bddcc38096b2349354748c175" prot="public">
          <name>Twentieth</name>
          <detaileddescription>
<para>All dates but the effective date are taken to be the twentieth of their month (used for CDS schedules in emerging markets.) The termination date is also modified. </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78ad694d6ae582abfc8e99ea7e6e6c3f8d5" prot="public">
          <name>TwentiethIMM</name>
          <detaileddescription>
<para>All dates but the effective date are taken to be the twentieth of an IMM month (used for CDS schedules.) The termination date is also modified. </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78a634c5fa704fceaa797cf0c089af2b6c9" prot="public">
          <name>OldCDS</name>
          <detaileddescription>
<para>Same as TwentiethIMM with unrestricted date ends and log/short stub coupon period (old CDS convention). </para>          </detaileddescription>
        </enumvalue>
        <enumvalue id="date_generation_1a11fcd51ef86118f65e603c1474377a78ac78cb76ca18746c78d962eb46eabb008" prot="public">
          <name>CDS</name>
          <detaileddescription>
<para>Credit derivatives standard rule since &apos;Big Bang&apos; changes in 2009. </para>          </detaileddescription>
        </enumvalue>
