QLCSRC=../../qlc/cpp

dll: libql.dll

so: libql.so

libql.dll: $(OBJS)
	g++ --shared -o libql.dll cpp/*.o -static-libstdc++ -static-libgcc -Wl,--output-def,cpp/libql.def,--out-implib,cpp/libql.a -lQuantLib $(EXTRA)

libql.so: $(OBJS)
	g++ --shared -o libql.so cpp/*.o -lQuantLib $(EXTRA)

