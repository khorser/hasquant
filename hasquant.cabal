cabal-version:      >=1.10
name:               hasquant
version:            0.1.0.0
synopsis:           Bindings to QuantLib
-- description:
-- bug-reports:
-- license:
-- license-file:        LICENSE
author:             Sergey Khorev
maintainer:         sergey.khorev@gmail.com
-- copyright:
category:           Finance
build-type:         Simple
-- extra-source-files:  cbits

flag buildExample
  Default: False

library
-- the order is important as it defines the order of preprocessing modules with c2hs
  exposed-modules:  QuantLib.Type
                    , QuantLib.Utility
                    , QuantLib.Math
                    , QuantLib.Currency
                    , QuantLib.Time.Period
                    , QuantLib.Time.Date
                    , QuantLib.Time.Calendar
                    , QuantLib.Time.Schedule
                    , QuantLib.Settings
                    , QuantLib.InterestRate
                    , QuantLib.Quote
                    , QuantLib.YieldTermStructure
                    , QuantLib.Index
                    , QuantLib.Index.InterestRate
                    , QuantLib.CashFlow
                    , QuantLib.Instrument
                    , QuantLib.Instrument.Swap
                    , QuantLib.Model
  other-modules:    QuantLib.Internal
  -- other-extensions:
  build-depends:    base >=4.12 && <5.0
                    , time
  -- hs-source-dirs:
  build-tools:      c2hs
  default-language: Haskell2010
  c-sources:        cbits/qlBond.cpp
                    , cbits/qlCalendar.cpp
                    , cbits/qlCouponPricer.cpp
                    , cbits/qlCredit.cpp
                    , cbits/qlCurrency.cpp
                    , cbits/qlDate.cpp
                    , cbits/qlDayCounter.cpp
                    , cbits/qlDefaultTS.cpp
                    , cbits/qlForward.cpp
                    , cbits/qlIborIndex.cpp
                    , cbits/qlIndex.cpp
                    , cbits/qlInstrument.cpp
                    , cbits/qlInterestRate.cpp
                    , cbits/qlLeg.cpp
                    , cbits/qlMath.cpp
                    , cbits/qlMethod.cpp
                    , cbits/qlModel.cpp
                    , cbits/qlOption.cpp
                    , cbits/qlPeriod.cpp
                    , cbits/qlPricingEngineAux.cpp
                    , cbits/qlPricingEngine.cpp
                    , cbits/qlProcess.cpp
                    , cbits/qlQuote.cpp
                    , cbits/qlSchedule.cpp
                    , cbits/qlSettings.cpp
                    , cbits/qlSwap.cpp
                    , cbits/qlTSAux.cpp
                    , cbits/qlUtilities.cpp
                    , cbits/qlVolatilityTS.cpp
                    , cbits/qlYieldTS.cpp

  include-dirs:     cbits
  ghc-options:      -Wall
  extra-libraries:  QuantLib stdc++
--  includes:         cbits/qlaux.h
--                    , cbits/qlBond.h
--                    , cbits/qlCalendar.h
--                    , cbits/qlCouponPricer.h
--                    , cbits/qlCredit.h
--                    , cbits/qlCurrency.h
--                    , cbits/qlDate.h
--                    , cbits/qlDayCounter.h
--                    , cbits/qlDefaultTS.h
--                    , cbits/qlEnumC2HS.h
--                    , cbits/qlForward.h
--                    , cbits/ql.h
--                    , cbits/qlIborIndex.h
--                    , cbits/qlIndex.h
--                    , cbits/qlInstrument.h
--                    , cbits/qlInterestRate.h
--                    , cbits/qlLeg.h
--                    , cbits/qlMath.h
--                    , cbits/qlMethod.h
--                    , cbits/qlModel.h
--                    , cbits/qlOption.h
--                    , cbits/qlPeriod.h
--                    , cbits/qlPricingEngineAux.h
--                    , cbits/qlPricingEngine.h
--                    , cbits/qlProcess.h
--                    , cbits/qlQuote.h
--                    , cbits/qlSchedule.h
--                    , cbits/qlSettings.h
--                    , cbits/qlSwap.h
--                    , cbits/qlTSAux.h
--                    , cbits/qlTypesC2HS.h
--                    , cbits/qlUtilities.h
--                    , cbits/qlVolatilityTS.h
--                    , cbits/qlYieldTS.h

executable hasquant_example
  if flag(buildExample)
    buildable: True
  else
    buildable: False

  main-is:          QuantLib/MainExample.hs
  other-modules: 
-- QuantLib.Example.Bond
--            , QuantLib.Example.BermudanSwaption
--            , QuantLib.Example.CallableBond
--            , QuantLib.Example.CDS
--            , QuantLib.Example.ConvertibleBond
--            , QuantLib.Example.EquityOption
--            , QuantLib.Example.FittedBondCurve
--            , QuantLib.Example.FRA
--            , QuantLib.Example.Replication
--            , QuantLib.Example.Repo
--            , QuantLib.Example.Swap
  ghc-options:      -Wall
  build-depends:    base >= 4.12 && < 5.0
                    , time
                    , hasquant
  default-language: Haskell2010
  hs-source-dirs:   test

test-suite hasquant_test
  Type:             exitcode-stdio-1.0
  Main-Is:          QuantLib/MainTest.hs
  Other-modules:
-- QuantLib.Test.HUnit
--              , QuantLib.Test.QuickCheck
--              , QuantLib.Test.CashFlows
--              , QuantLib.Test.Dates
--              , QuantLib.Test.DayCounters
--              , QuantLib.Test.InterestRates
--              , QuantLib.Test.Period
--              , QuantLib.Test.Rounding
--              , QuantLib.Test.TermStructures
--              , QuantLib.Test.Schedule
--              , QuantLib.Example.Bond
--              , QuantLib.Example.BermudanSwaption
--              , QuantLib.Example.CallableBond
--              , QuantLib.Example.CDS
--              , QuantLib.Example.ConvertibleBond
--              , QuantLib.Example.EquityOption
--              , QuantLib.Example.FittedBondCurve
--              , QuantLib.Example.FRA
--              , QuantLib.Example.Replication
--              , QuantLib.Example.Repo
--              , QuantLib.Example.Swap
  ghc-options:      -Wall
  Build-Depends:    base >= 4.12 && < 5.0
                    , time
                    , hspec
                    , HUnit
                    , QuickCheck
                    , hasquant
  Default-Language: Haskell2010
  Hs-source-dirs:   test

